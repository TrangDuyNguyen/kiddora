{
  "mcpServers": {
    "flutter-preview": {
      "type": "stdio",
      "command": "/Users/nguyenduytrang/.antigravity-ide/extensions/felipefontes.flutter-widget-preview-0.1.15-universal/.mcp-scripts/run-mcp-preview.sh",
      "args": []
    },
    "lottiefiles-creator": {
      "command": "npx",
      "args": [
        "-y",
        "@lottiefiles/creator-mcp@latest"
      ]
    },
    "docker": {
      "command": "/Applications/Docker.app/Contents/Resources/bin/docker",
