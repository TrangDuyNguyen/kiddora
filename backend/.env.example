# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://kiddora:kiddora_secret@db:5432/kiddora

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── MinIO (File Storage) ─────────────────────────────────────
# MINIO_ENDPOINT: Nội bộ giữa các Docker containers (giữ nguyên minio:9000)
# MINIO_PUBLIC_ENDPOINT: Để trống sẽ tự động ký S3v4 theo IP LAN/Tailscale mà Client gọi vào;
#                        chỉ điền cố định (vd: storage.kiddora.com) khi deploy lên VPS có domain.
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=kiddora-storage
MINIO_USE_SSL=false

# ── LiveKit ──────────────────────────────────────────────────
# LIVEKIT_URL: Nội bộ giữa các Docker containers
# LIVEKIT_PUBLIC_URL: Để trống sẽ tự động trả ws://<IP_SERVER>:7880 theo IP LAN/Tailscale Client gọi
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# ── JWT Auth ─────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_VERY_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── FCM (Push Notifications) ─────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=/app/firebase-service-account.json
FCM_PROJECT_ID=your-firebase-project-id

# ── App ──────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
